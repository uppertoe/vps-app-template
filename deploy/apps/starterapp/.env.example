# Copy to apps/starterapp/.env in the server repo (on the server it is set to
# mode 600 by ./deploy). The app refuses to start while any value still reads
# CHANGE_ME.

# The app's address as people see it.
PUBLIC_URL=https://CHANGE_ME.example.org
# The gateway's address, for the Sign out link. Leave unset to use
# auth.<the server's domain>.
#AUTH_URL=https://auth.example.org

# Email: off, log (print to the log) or smtp (send through SES). Mint SMTP
# credentials with scripts/aws-ses-setup.py in the server repo.
EMAIL_BACKEND=off
#EMAIL_FROM=Starter app <starter@example.org>
#SMTP_HOST=email-smtp.ap-southeast-2.amazonaws.com
#SMTP_USER=CHANGE_ME
#SMTP_PASS=CHANGE_ME

# Reading group members from the gateway, for an app that lists groups under
# members in app.yaml. The platform owner sets the same token in the gateway's
# MEMBER_READER_TOKEN_<APP>.
#GATEWAY_MEMBERS_URL=http://auth:8081
#GATEWAY_MEMBERS_TOKEN=CHANGE_ME
