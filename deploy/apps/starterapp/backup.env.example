# Copy to backup/services/starterapp.env in the server repo (gitignored), fill
# in the password, and run the backup playbook. The backup copies the hourly
# snapshot, never the live database: a copy of the live file taken mid-write
# may not restore.
SERVICE_NAME=starterapp
RESTIC_REPOSITORY=s3:s3.amazonaws.com/CHANGE_ME/backups/starterapp-backup
# python3 -c "import secrets; print(secrets.token_urlsafe(32))", and keep a
# copy in the password manager: without it the backups cannot be read.
RESTIC_PASSWORD=
BACKUP_PATHS=/var/lib/docker/volumes/deploy_starterapp_data/_data/snapshot
