# Generated from the app's route list by vps-app-kit. Do not edit:
# change the routes in the app, then run make generate.
# Keep comments free of braces: the server's route renderer counts them.
starter.{$DOMAIN} {
	# GET /healthz: public (container health check)
	@r1 path /healthz
	handle @r1 {
		# scaffold-lint: open-path -- /healthz: container health check
		reverse_proxy starterapp:8080 {
			import strip_public
		}
	}
	# GET /privacy: public (the privacy policy)
	@r2 path /privacy
	handle @r2 {
		# scaffold-lint: open-path -- /privacy: the privacy policy
		reverse_proxy starterapp:8080 {
			import strip_public
		}
	}
	# GET /admin: group starterapp_admin
	@r3 path /admin
	handle @r3 {
		import protected_groups "starterapp_admin" starterapp:8080
	}
	# GET /notes, POST /notes: signed in
	@r4 path /notes
	handle @r4 {
		import protected starterapp:8080
	}
	# GET /<$>: public (the landing page)
	@r5 path /
	handle @r5 {
		# scaffold-lint: open-path -- /: the landing page
		reverse_proxy starterapp:8080 {
			import strip_public
		}
	}
	# GET /static/: public (stylesheets, scripts and fonts)
	@r6 path /static /static/*
	handle @r6 {
		# scaffold-lint: open-path -- /static /static/*: stylesheets, scripts and fonts
		reverse_proxy starterapp:8080 {
			import strip_public
		}
	}
	# GET /brand/: public (logo and icons)
	@r7 path /brand /brand/*
	handle @r7 {
		# scaffold-lint: open-path -- /brand /brand/*: logo and icons
		reverse_proxy starterapp:8080 {
			import strip_public
		}
	}
	# Any path the app did not register.
	handle {
		# scaffold-lint: open-path -- every other path: answered 404 by Caddy, nothing reaches the app
		respond 404
	}
}
