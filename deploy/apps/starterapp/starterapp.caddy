# Generated from the app's route list by vps-app-kit. Do not edit:
# change the routes in the app, then run make generate.
# Keep comments free of braces: the server's route renderer counts them.
# scaffold-app-label: "Starter app"
# scaffold-roles: admin "Administrator"
starter.{$DOMAIN} {
	# GET /healthz: public (container health check)
	@r1 path /healthz
	handle @r1 {
		# scaffold-lint: open-path -- /healthz: container health check
		reverse_proxy starterapp:8080 {
			import strip_public
		}
	}
	# GET /privacy: public (the privacy policy)
	@r2 path /privacy
	handle @r2 {
		# scaffold-lint: open-path -- /privacy: the privacy policy
		reverse_proxy starterapp:8080 {
			import strip_public
		}
	}
	# GET /admin: role admin
	@r3 path /admin
	handle @r3 {
		import role "starterapp" "admin" starterapp:8080
	}
	# GET /notes, POST /notes: role user
	@r4 path /notes
	handle @r4 {
		import role "starterapp" "user" starterapp:8080
	}
	# GET /<$>: public (the landing page)
	@r5 path /
	handle @r5 {
		# scaffold-lint: open-path -- /: the landing page
		reverse_proxy starterapp:8080 {
			import strip_public
		}
	}
	# GET /static/: public (stylesheets, scripts and fonts)
	@r6 path /static /static/*
	handle @r6 {
		# scaffold-lint: open-path -- /static /static/*: stylesheets, scripts and fonts
		reverse_proxy starterapp:8080 {
			import strip_public
		}
	}
	# GET /brand/: public (logo and icons)
	@r7 path /brand /brand/*
	handle @r7 {
		# scaffold-lint: open-path -- /brand /brand/*: logo and icons
		reverse_proxy starterapp:8080 {
			import strip_public
		}
	}
	# Any path the app did not register: answered 404 by Caddy, so nothing
	# undeclared reaches the app. On a site with roles it is answered only
	# to a holder of the user role, as the renderer requires of a catch-all.
	handle {
		import role_gate "starterapp" "user"
		respond 404
	}
}
